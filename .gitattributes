# batch files must be CRLF or cmd mis-parses multi-line blocks
*.cmd text eol=crlf
*.bat text eol=crlf
# shell scripts must be LF or the shebang breaks
*.sh text eol=lf
# markdown and text: normalise to LF so line-based patching is predictable
*.md text eol=lf
*.txt text eol=lf
# python: LF, so line-based patching is predictable
*.py text eol=lf
